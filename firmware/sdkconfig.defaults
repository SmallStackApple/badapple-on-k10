# UNIHIKER K10 (ESP32-S3 N16R8)
CONFIG_IDF_TARGET="esp32s3"

# 16MB flash, DIO @ 80MHz (same as the official K10 BSP)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# CPU and tick
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Console on the native USB-Serial/JTAG (COM8)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_NONE=n

# Custom partition table (2MB app + media partition)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Keep the image small: no WiFi / BT
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_ENABLED=n

# Panic behaviour
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y

# Larger main task stack for the player
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
